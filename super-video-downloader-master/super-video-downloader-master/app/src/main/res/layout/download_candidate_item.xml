<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
            name="listener"
            type="com.myAllVideoBrowser.ui.component.adapter.CandidateFormatListener" />

        <variable
            name="download_candidate"
            type="String" />

        <variable
            name="is_candidate_selected"
            type="Boolean" />

        <variable
            name="videoInfo"
            type="com.myAllVideoBrowser.data.local.room.entity.VideoInfo" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:checkable="true"
        android:checked="@{is_candidate_selected}"
        android:onClick="@{() -> listener.onSelectFormat(videoInfo, download_candidate)}"
        android:onLongClick="@{() -> listener.onFormatUrlShare(videoInfo, download_candidate)}"
        app:cardCornerRadius="@dimen/detected_candidate_radius"
        app:checkedIconTint="@color/browser_home_shortcut_icon"
        app:strokeColor="@{is_candidate_selected ? @color/detected_chip_selected_stroke : @color/detected_chip_stroke}"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@{is_candidate_selected ? @color/detected_chip_selected : @color/detected_chip_surface}"
            android:gravity="center_vertical"
            android:minWidth="122dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/processing_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="4"
                android:textColor="@color/detected_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>
