<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_guide_screen">

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/header_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/guide_back"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/arrow_back24px"
        app:tint="@color/black" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="56dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_timeline_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="32dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_content_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="68dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/guide_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/guide_title"
                android:textColor="@color/black"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/guide_timeline"
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_guide_timeline"
                app:layout_constraintBottom_toBottomOf="@id/guide_preview_two"
                app:layout_constraintEnd_toEndOf="@id/guide_badge_one"
                app:layout_constraintStart_toStartOf="@id/guide_badge_one"
                app:layout_constraintTop_toBottomOf="@id/guide_badge_one" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/guide_badge_one"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="103dp"
                android:background="@drawable/bg_guide_step_badge"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="1"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="@id/guide_timeline_start"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/guide_step_one_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxWidth="258dp"
                android:text="@string/guide_step_one"
                android:textColor="@color/black"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/guide_content_start"
                app:layout_constraintTop_toTopOf="@id/guide_badge_one" />

            <FrameLayout
                android:id="@+id/guide_preview_one"
                android:layout_width="258dp"
                android:layout_height="163dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="@id/guide_content_start"
                app:layout_constraintTop_toBottomOf="@id/guide_step_one_text">

                <FrameLayout
                    android:layout_width="234dp"
                    android:layout_height="155dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_guide_phone_frame_top"
                    android:padding="5dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white">

                        <View
                            android:id="@+id/guide_preview_one_glow"
                            android:layout_width="0dp"
                            android:layout_height="78dp"
                            android:background="@drawable/bg_guide_preview_top_panel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/guide_preview_one_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:text="9:41"
                            android:textColor="@color/black"
                            android:textSize="6sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:id="@+id/guide_preview_one_status"
                            android:layout_width="18dp"
                            android:layout_height="4dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="@color/black"
                            android:alpha="0.85"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/guide_preview_one_info"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="24dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_home_info" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/guide_preview_one_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="27dp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:text="@string/guide_demo_downloader"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <FrameLayout
                            android:id="@+id/guide_preview_one_count"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginTop="25dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_home_tab_count"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="1"
                                android:textColor="@color/black"
                                android:textSize="7sp" />
                        </FrameLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/guide_preview_one_search"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginTop="56dp"
                            android:layout_marginEnd="3dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="3dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:paddingEnd="12dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="17dp"
                                    android:layout_height="17dp"
                                    app:srcCompat="@drawable/search_24px"
                                    app:tint="@color/black" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="sans-serif"
                                    android:includeFontPadding="false"
                                    android:text="@string/guide_demo_search"
                                    android:textColor="@color/home_hint"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/guide_preview_one_bookmark"
                            android:layout_width="106dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="19dp"
                            android:layout_marginTop="98dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    app:srcCompat="@drawable/bookmarks_24px"
                                    app:tint="@color/colorPrimary" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="sans-serif"
                                    android:includeFontPadding="false"
                                    android:text="@string/guide_demo_bookmark"
                                    android:textColor="@color/black"
                                    android:textSize="9sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/guide_preview_one_history"
                            android:layout_width="106dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="98dp"
                            android:layout_marginEnd="19dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    app:srcCompat="@drawable/history_menu_icon_24dp"
                                    app:tint="@color/colorPrimary" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="sans-serif"
                                    android:includeFontPadding="false"
                                    android:text="@string/guide_demo_history"
                                    android:textColor="@color/black"
                                    android:textSize="9sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/guide_badge_two"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_guide_step_badge"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="2"
                android:textColor="@color/black"
                android:textSize="11sp"
                app:layout_constraintStart_toStartOf="@id/guide_timeline_start"
                app:layout_constraintTop_toBottomOf="@id/guide_preview_one" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/guide_step_two_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="32dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxWidth="258dp"
                android:text="@string/guide_step_two"
                android:textColor="@color/black"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/guide_content_start"
                app:layout_constraintTop_toTopOf="@id/guide_badge_two" />

            <FrameLayout
                android:id="@+id/guide_preview_two"
                android:layout_width="258dp"
                android:layout_height="163dp"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="@id/guide_content_start"
                app:layout_constraintTop_toBottomOf="@id/guide_step_two_text">

                <FrameLayout
                    android:layout_width="234dp"
                    android:layout_height="155dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_guide_phone_frame_bottom"
                    android:padding="5dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/guide_preview_two_image_left"
                            android:layout_width="102dp"
                            android:layout_height="86dp"
                            android:layout_marginStart="18dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="2dp"
                            app:cardElevation="0dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_guide_photo_left">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical">

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="54dp"
                                        android:background="#1AFFFFFF" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:background="#33000000" />
                                </LinearLayout>

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_gravity="bottom|end"
                                    android:layout_marginEnd="4dp"
                                    android:layout_marginBottom="4dp"
                                    app:cardBackgroundColor="#1A000000"
                                    app:cardCornerRadius="7dp"
                                    app:cardElevation="0dp">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="9dp"
                                        android:layout_height="9dp"
                                        android:layout_gravity="center"
                                        app:srcCompat="@drawable/ic_download_24dp"
                                        app:tint="@color/white" />
                                </com.google.android.material.card.MaterialCardView>
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/guide_preview_two_image_right"
                            android:layout_width="102dp"
                            android:layout_height="86dp"
                            android:layout_marginEnd="18dp"
                            app:cardBackgroundColor="@android:color/transparent"
                            app:cardCornerRadius="2dp"
                            app:cardElevation="0dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_guide_photo_right">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical">

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="42dp"
                                        android:background="#14FFFFFF" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1"
                                        android:background="#10000000" />
                                </LinearLayout>

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_gravity="bottom|end"
                                    android:layout_marginEnd="4dp"
                                    android:layout_marginBottom="4dp"
                                    app:cardBackgroundColor="#1A000000"
                                    app:cardCornerRadius="7dp"
                                    app:cardElevation="0dp">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="9dp"
                                        android:layout_height="9dp"
                                        android:layout_gravity="center"
                                        app:srcCompat="@drawable/ic_download_24dp"
                                        app:tint="@color/white" />
                                </com.google.android.material.card.MaterialCardView>
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/guide_preview_two_bottom_bar"
                            android:layout_width="220dp"
                            android:layout_height="46dp"
                            android:layout_marginBottom="7dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="3dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/guide_preview_two_nav_bookmark"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    app:srcCompat="@drawable/bookmarks_24px"
                                    app:tint="@color/home_tab_unselected"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/guide_preview_two_nav_back"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    app:srcCompat="@drawable/arrow_back24px"
                                    app:tint="@color/home_tab_unselected"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:layout_marginStart="38dp" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/guide_preview_two_nav_forward"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    app:srcCompat="@drawable/arrow_forward24px"
                                    app:tint="@color/home_tab_unselected"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    android:layout_marginEnd="38dp" />

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/guide_preview_two_nav_share"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    app:srcCompat="@drawable/share_24px"
                                    app:tint="@color/home_tab_unselected"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <FrameLayout
                            android:id="@+id/guide_preview_two_download"
                            android:layout_width="66dp"
                            android:layout_height="66dp"
                            android:background="@drawable/bg_guide_download_fab"
                            android:elevation="6dp"
                            app:layout_constraintBottom_toBottomOf="@id/guide_preview_two_bottom_bar"
                            app:layout_constraintEnd_toEndOf="@id/guide_preview_two_bottom_bar"
                            app:layout_constraintStart_toStartOf="@id/guide_preview_two_bottom_bar"
                            app:layout_constraintTop_toTopOf="@id/guide_preview_two_bottom_bar">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                app:srcCompat="@drawable/ic_download_24dp"
                                app:tint="@color/black" />
                        </FrameLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
