<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.main.home.browser.homeTab.BrowserHomeFragment">

    <data>

        <import type="android.view.View" />

        <import type="com.myAllVideoBrowser.R" />

        <variable
            name="viewModel"
            type="com.myAllVideoBrowser.ui.main.home.browser.webTab.WebTabViewModel" />

        <variable
            name="videoTabVModel"
            type="com.myAllVideoBrowser.ui.main.home.browser.detectedVideos.IVideoDetector" />

        <variable
            name="browserMenuListener"
            type="com.myAllVideoBrowser.ui.main.home.browser.BrowserListener" />

        <variable
            name="settingsViewModel"
            type="com.myAllVideoBrowser.ui.main.settings.SettingsViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/customView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/containerBrowser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:background="@color/white"
                    app:layout_scrollFlags="scroll|enterAlways|snap">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/iv_home_back"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:onClick="@{() -> browserMenuListener.onBrowserHomeClicked()}"
                            android:src="@drawable/homeback"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:id="@+id/address_container"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_home_search_pill"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/tab_count_container"
                            app:layout_constraintStart_toEndOf="@id/iv_home_back"
                            app:layout_constraintTop_toTopOf="parent">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/bt_search"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="8dp"
                                android:tint="@color/black"
                                app:srcCompat="@drawable/search_24px" />

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/et_search"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:focusable="@{viewModel.isTabInputFocused}"
                                android:focusableInTouchMode="@{viewModel.isTabInputFocused}"
                                android:hint="@string/browser_search_hint"
                                android:maxLines="1"
                                android:onClick="@{() -> viewModel.changeTabFocus(true)}"
                                android:padding="0dp"
                                android:singleLine="true"
                                android:text="@{viewModel.getTabTextInput()}"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                app:items="@{viewModel.listTabSuggestions.get()}" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/tab_count_container"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_browser_tab_count_badge"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClick="@{() -> browserMenuListener.onTabsSwitcherClicked()}"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tv_tab_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:includeFontPadding="false"
                                android:text='@{(viewModel.thisTabIndex + 1) + ""}'
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="1" />
                        </FrameLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>

            </com.google.android.material.appbar.AppBarLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <LinearLayout
                    android:id="@+id/webview_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="@dimen/home_bottom_bar_size"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <FrameLayout
                    android:layout_width="3dp"
                    android:layout_height="700dp"
                    android:visibility="@{(videoTabVModel.hasCheckLoadingsM3u8() || videoTabVModel.hasCheckLoadingsRegular()) ? View.VISIBLE : View.GONE }"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ProgressBar
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="700dp"
                        android:layout_height="match_parent"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/progress_load_data"
                        android:rotation="90" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/fullscreen_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/browser_progress_size"
                    android:background="@android:color/transparent"
                    android:progress="@{viewModel.progress}"
                    android:progressDrawable="@drawable/progress_load_data"
                    android:visibility="@{viewModel.isShowProgress ? View.VISIBLE : View.GONE}"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/browser_floating_toolbar"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/browser_floating_toolbar_height"
                    android:layout_marginStart="@dimen/browser_floating_toolbar_margin"
                    android:layout_marginEnd="@dimen/browser_floating_toolbar_margin"
                    android:layout_marginBottom="@dimen/browser_floating_toolbar_bottom_margin"
                    android:backgroundTint="#ffffff"
                    app:cardBackgroundColor="#ffffff"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="@dimen/browser_floating_toolbar_elevation"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:strokeColor="#ffffff">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/toolbar_bookmark"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/browser_action_bookmark"
                            android:padding="14dp"
                            android:src="@drawable/bookmarks_24px" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/toolbar_back"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/browser_action_back"
                            android:padding="14dp"
                            android:src="@drawable/arrow_back24px" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/toolbar_download"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="14dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/browser_action_forward"
                            android:padding="14dp"
                            android:src="@drawable/ic_download_24dp" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/toolbar_forward"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/browser_action_forward"
                            android:padding="14dp"
                            android:src="@drawable/arrow_forward24px" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/toolbar_share"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/browser_action_share"
                            android:padding="14dp"
                            android:src="@drawable/share_24px" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </FrameLayout>

</layout>
