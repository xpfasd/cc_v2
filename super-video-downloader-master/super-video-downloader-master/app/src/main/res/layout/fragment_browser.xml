<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.myAllVideoBrowser.ui.main.home.browser.BrowserViewModel" />

    </data>

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.myAllVideoBrowser.ui.main.home.browser.CustomViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:currentItem="@{viewModel.currentTab}"
            app:items="@{viewModel.tabs.get()}" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/drawer_layout_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/home_background"
            android:fitsSystemWindows="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/new_tab_button"
                android:layout_width="@dimen/browser_tabs_header_action_size"
                android:layout_height="@dimen/browser_tabs_header_action_size"
                android:layout_marginStart="@dimen/browser_tabs_header_side_padding"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/new_tab"
                android:padding="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_browser_tabs_add_24" />

            <TextView
                android:id="@+id/tabs_overview_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/new_tab_button"
                app:layout_constraintEnd_toStartOf="@id/clear_tabs_button"
                app:layout_constraintStart_toEndOf="@id/new_tab_button"
                app:layout_constraintTop_toTopOf="@id/new_tab_button"
                tools:text="2 tabs" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/clear_tabs_button"
                android:layout_width="@dimen/browser_tabs_header_action_size"
                android:layout_height="@dimen/browser_tabs_header_action_size"
                android:layout_marginEnd="@dimen/browser_tabs_header_side_padding"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/browser_tabs_overview_clear_all"
                android:padding="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/delete_forever_24px" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tabs_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingStart="@dimen/browser_tabs_overview_side_padding"
                android:paddingTop="22dp"
                android:paddingEnd="@dimen/browser_tabs_overview_side_padding"
                android:paddingBottom="24dp"
                app:items="@{viewModel.tabs.get()}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/new_tab_button" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

</layout>
